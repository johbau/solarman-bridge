# Copy this file to pi/.env and fill in your values.
# The pi/.env file is gitignored and deployed to /opt/solarman-bridge on the Pi.

# IP or hostname of your Deye WiFi dongle / Solarman logger
WR_HOST=192.168.1.100

# 10-digit serial number printed on the WiFi dongle label
WR_SERIAL=1234567890

# Solarman v5 protocol port (default 8899, almost never different)
WR_PORT=8899

# Modbus slave ID (default 1)
WR_SLAVE=1
