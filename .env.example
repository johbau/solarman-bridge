# Copy this file to .env and fill in your values.
# The .env file is gitignored; do not commit it.

# IP or hostname of your Deye WiFi dongle / Solarman logger
WR_HOST=192.168.1.100

# 10-digit serial number printed on the WiFi dongle label
WR_SERIAL=1234567890

# Solarman v5 protocol port (default 8899, almost never different)
WR_PORT=8899

# Modbus slave ID (default 1)
WR_SLAVE=1

# --- soc_switch.py: FRITZ!DECT switch controlled by battery SOC ---
# FRITZ!Box address and a user with smart-home permission
FRITZ_HOST=fritz.box
FRITZ_USER=myuser
FRITZ_PASS=mypassword
# AIN of the DECT switch (printed on the device, spaces optional)
FRITZ_AIN=087610000000
# Seasonal switching:
#   summer: ON at SOC >= SUMMER_ON (sell surplus), OFF at SOC <= SUMMER_OFF
#   winter: ON at SOC <= WINTER_ON (buy energy),   OFF at SOC >= WINTER_OFF
# SEASON: auto (by month) | summer | winter
SEASON=auto
SUMMER_MONTHS=4,5,6,7,8,9
SUMMER_ON=95
SUMMER_OFF=85
WINTER_ON=15
WINTER_OFF=25
# Bridge URL and poll interval in seconds
BRIDGE_URL=http://127.0.0.1:7071
SOC_POLL=60
